#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x=64, local_size_y=1, local_size_z=1) in;

layout(set=0, binding=0) buffer PackedHalfData {
    uint data[];
};

layout(push_constant) uniform Params {
    uint count;
    float scale;
    float bias;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    vec2 unpacked = unpackHalf2x16(data[i]);
    f16vec2 h = f16vec2(unpacked);
    h = h * float16_t(pc.scale) + float16_t(pc.bias);
    data[i] = packHalf2x16(vec2(h));
}
