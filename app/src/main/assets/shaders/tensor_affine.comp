#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0) readonly buffer Input { float x[]; };
layout(set=0,binding=1) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Params { uint count; float scale; float bias; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<pc.count) y[i]=x[i]*pc.scale+pc.bias;
}
